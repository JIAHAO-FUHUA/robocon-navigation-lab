<?xml version="1.0"?>
<robot name="club_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.08"/><mass value="8"/><inertia ixx="0.12" iyy="0.18" izz="0.28" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><box size="0.5 0.4 0.1"/></geometry><material name="blue"><color rgba="0.2 0.4 0.8 1"/></material></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="0.5 0.4 0.1"/></geometry></collision>
  </link>
  <xacro:include filename="$(find livox_gz_sim)/urdf/mid360.xacro"/>
  <xacro:mid360 parent="base_link" xfer_format="1" publish_freq="10.0" slices="5" downsample="1" resolution="0.8" noise="false">
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </xacro:mid360>
</robot>
